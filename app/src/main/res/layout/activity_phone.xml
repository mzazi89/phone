<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnClearRecents"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/tab_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/recents_clear"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================ KEYPAD ============================ -->
        <LinearLayout
            android:id="@+id/pageKeypad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:gravity="end|center_vertical"
                android:hint="@string/dial_hint"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="58dp"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tvMatchedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:minHeight="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/t9List"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvSmartHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="@string/smart_dial_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </FrameLayout>

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:columnCount="3"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:rowCount="4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/btnAddContact"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/round_button_bg"
                        android:clickable="true"
                        android:contentDescription="@string/add_contact"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnCall"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/call_button_bg"
                    android:clickable="true"
                    android:contentDescription="@string/call"
                    android:focusable="true"
                    android:padding="20dp"
                    android:src="@drawable/ic_call" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/btnBackspace"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/round_button_bg"
                        android:clickable="true"
                        android:contentDescription="@string/backspace"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_backspace"
                        android:tint="@color/text_secondary" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- =========================== CONTACTS =========================== -->
        <LinearLayout
            android:id="@+id/pageContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/search_bg"
                android:hint="@string/search_contacts"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/contactsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvContactsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/contacts_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/contactsPermissionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/contacts_permission_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/contacts_permission_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnAllowContacts"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/key_dial_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/contacts_permission_action"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ============================ RECENTS =========================== -->
        <LinearLayout
            android:id="@+id/pageRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvRecentsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/recents_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabKeypad"
            style="@style/TabLabel"
            android:text="@string/tab_keypad" />

        <TextView
            android:id="@+id/tabContacts"
            style="@style/TabLabel"
            android:text="@string/tab_contacts" />

        <TextView
            android:id="@+id/tabRecents"
            style="@style/TabLabel"
            android:text="@string/tab_recents" />
    </LinearLayout>
</LinearLayout>
